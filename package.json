{
  "name": "madadtheory-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mad Ad Theory — Performance Marketing Agency Connected Platform (React + Vite + Node.js + MongoDB)",
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "clsx": "^2.1.1",
