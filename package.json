    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "framer-motion": "^12.4.7",
    "gsap": "^3.12.7",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.475.0",
    "mongoose": "^8.9.5",
    "multer": "^2.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.5",
    "resend": "^6.37.0",
    "tailwind-merge": "^3.0.1",
    "three": "^0.187.0",
    "zod": "^3.24.2"
